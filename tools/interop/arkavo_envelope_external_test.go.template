package sdk

import (
	"archive/zip"
	"bytes"
	"context"
	"encoding/json"
	"hash/crc32"
	"io"
	"net/http"
	"os"
	"path/filepath"
	"testing"
)

// Test-only unwrap seam: no KAS contacted and no production key used.
func TestArkavoExternalEnvelope(t *testing.T) {
	dir := os.Getenv("ARKAVO_ENVELOPE_FIXTURE")
	if dir == "" {
		dir = "/tmp/arkavo-envelope-fixture"
	}
	raw, err := os.ReadFile(dir + "/envelope.tdf")
	if err != nil {
		t.Fatal(err)
	}
	key, err := os.ReadFile(dir + "/test-dek.bin")
	if err != nil {
		t.Fatal(err)
	}
	valid, err := IsValidTdf(bytes.NewReader(raw))
	if err != nil || !valid {
		t.Fatalf("schema: %v %v", valid, err)
	}
	s := SDK{conn: &ConnectRPCConnection{Client: http.DefaultClient}}
	r, err := s.LoadTDF(bytes.NewReader(raw), WithSchemaValidation(Strict), WithKasAllowlist([]string{"https://platform.arkavo.net"}))
	if err != nil {
		t.Fatal(err)
	}
	if err := r.buildKey(context.Background(), []kaoResult{{KeyAccessObjectID: "kao-0", SymmetricKey: key}}); err != nil {
		t.Fatal(err)
	}
	decrypted, err := io.ReadAll(r)
	if err != nil {
		t.Fatal(err)
	}
	var envelope struct {
		Profile string `json:"profile"`
		Tracks  []struct {
			ID string `json:"id"`
		} `json:"tracks"`
	}
	if err := json.Unmarshal(decrypted, &envelope); err != nil {
		t.Fatal(err)
	}
	if envelope.Profile != "urn:arkavo:fairplay:key-envelope:1" || len(envelope.Tracks) < 1 || len(envelope.Tracks) > 2 {
		t.Fatalf("unexpected envelope profile or track count")
	}
	t.Logf("Strict schema, key reconstruction, root integrity and payload decryption passed; tracks=%d", len(envelope.Tracks))
	zr, err := zip.NewReader(bytes.NewReader(raw), int64(len(raw)))
	if err != nil {
		t.Fatal(err)
	}
	var corrupted bytes.Buffer
	zw := zip.NewWriter(&corrupted)
	for _, f := range zr.File {
		rd, err := f.Open()
		if err != nil {
			t.Fatal(err)
		}
		data, err := io.ReadAll(rd)
		rd.Close()
		if err != nil {
			t.Fatal(err)
		}
		if f.Name == "0.payload" {
			data[12] ^= 1
		}
		dst, err := zw.CreateRaw(&zip.FileHeader{Name: f.Name, Method: zip.Store, CRC32: crc32.ChecksumIEEE(data), CompressedSize64: uint64(len(data)), UncompressedSize64: uint64(len(data))})
		if err != nil {
			t.Fatal(err)
		}
		if _, err = dst.Write(data); err != nil {
			t.Fatal(err)
		}
	}
	if err = zw.Close(); err != nil {
		t.Fatal(err)
	}
	bad, err := s.LoadTDF(bytes.NewReader(corrupted.Bytes()), WithSchemaValidation(Strict), WithKasAllowlist([]string{"https://platform.arkavo.net"}))
	if err != nil {
		t.Fatal(err)
	}
	if err = bad.buildKey(context.Background(), []kaoResult{{KeyAccessObjectID: "kao-0", SymmetricKey: key}}); err != nil {
		t.Fatal(err)
	}
	if _, err = io.ReadAll(bad); err == nil {
		t.Fatal("tampered GCM ciphertext accepted")
	}
	t.Log("Ciphertext tampering rejected by reference reader")
}
